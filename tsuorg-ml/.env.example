# Copy to .env and adjust paths if your Tesseract install differs.
# Accuracy: use tessdata_best (NOT tessdata_fast).

CALSV_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CALSV_TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata_best
CALSV_TESSERACT_LANG=eng
CALSV_TESSERACT_OEM=1
CALSV_TESSERACT_PSM=6
CALSV_TESSERACT_DPI=300
CALSV_CONFIDENCE_THRESHOLD=60

# LayoutLMv3 checkpoint root (finetune writes models/layoutlmv3-tsu-v1/best/)
CALSV_MODEL_DIR=models
CALSV_MODEL_NAME=layoutlmv3-tsu-v1
