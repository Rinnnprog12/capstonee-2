@page "/review/queue"
@layout PortalLayout
@attribute [Authorize(Roles = "Adviser,Dean")]
@inject ApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Review Queue</PageTitle>

<div class="page-head">
    <a class="back-btn" href="review">← Back</a>
    <h1>Review Queue</h1>
    <span class="badge badge-review" style="margin-left:auto;">@_allCount pending</span>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="form-error" role="alert">@_error</p>
}

<div class="tabs">
    @foreach (var tab in Tabs)
    {
        <button type="button"
                class="tab @(_tab == tab.Api ? "active" : null)"
                @onclick="() => SwitchTabAsync(tab.Api)">
            @tab.Label (@TabCount(tab.Api))
        </button>
    }
</div>

@if (_loading)
{
    <p class="hint">Loading queue…</p>
}
else if (_items.Count == 0)
{
    <section class="panel">
        <p class="empty-state">
            No documents waiting for your review at stage <strong>@StageName</strong>.
            Submissions appear here after a student officer confirms their upload.
        </p>
    </section>
}
else
{
    <div class="recent-list" role="list">
        @foreach (var item in _items)
        {
            <button type="button"
                    class="list-row list-row-btn queue-row"
                    role="listitem"
                    @onclick="() => OpenReview(item.DocumentId)">
                <div class="doc-ico @(item.RequiresHumanReview ? "purple" : "")">📄</div>
                <div>
                    <div class="title">@item.Title</div>
                    <div class="meta">
                        @item.DocumentNumber · @item.OrganizationName · @TypeLabel(item) · @item.SubmittedAt.ToLocalTime().ToString("MMMM d, yyyy")
                    </div>
                </div>
                <div class="right">
                    @if (item.RequiresHumanReview)
                    {
                        <span class="badge badge-flagged">Flagged</span>
                    }
                    @if (item.LatestValidationConfidence is decimal c)
                    {
                        var pct = ToPercent(c);
                        <span class="score compliance-score @ScoreTone(pct)">
                            <strong>@pct%</strong><br />
                            <small>compliance</small>
                        </span>
                    }
                    else
                    {
                        <span class="val-muted">Awaiting AI</span>
                    }
                </div>
            </button>
        }
    </div>

    @if (_totalCount > _pageSize)
    {
        <div class="pagination">
            <button class="btn btn-ghost btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">← Prev</button>
            <span>Page @_page of @TotalPages</span>
            <button class="btn btn-ghost btn-sm" disabled="@(_page >= TotalPages)" @onclick="NextPage">Next →</button>
        </div>
    }
}

@code {
    private static readonly (string Api, string Label)[] Tabs =
    [
        ("All", "All"),
        ("Flagged", "Flagged"),
        ("Cleaned", "Cleaned"),
    ];

    private string _tab = "All";
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private readonly int _pageSize = 20;
    private int _totalCount;
    private int _allCount;
    private int _flaggedCount;
    private int _cleanedCount;
    private readonly List<ReviewQueueItemDto> _items = [];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private string StageName => Session.Role switch
    {
        "Adviser" => "Adviser",
        "Dean" => "College Dean",
        _ => "—",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SwitchTabAsync(string tab)
    {
        if (_tab == tab && !_loading) return;
        _tab = tab;
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetReviewQueueAsync(_tab, _page, _pageSize);
            _items.Clear();
            _items.AddRange(result.Items);
            _totalCount = result.TotalCount;
            _allCount = result.AllCount;
            _flaggedCount = result.FlaggedCount;
            _cleanedCount = result.CleanedCount;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private int TabCount(string tab) => tab switch
    {
        "Flagged" => _flaggedCount,
        "Cleaned" => _cleanedCount,
        _ => _allCount,
    };

    private void OpenReview(Guid id) => Nav.NavigateTo($"/review/decide/{id}?from=queue");

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private static string TypeLabel(ReviewQueueItemDto item) =>
        string.IsNullOrWhiteSpace(item.DocumentTypeName) ? item.DocumentTypeCode : item.DocumentTypeName;

    private static int ToPercent(decimal confidence) =>
        (int)Math.Round(confidence > 1m ? confidence : confidence * 100);

    private static string ScoreTone(int pct) => pct switch
    {
        >= 80 => "ok",
        >= 60 => "warn",
        _ => "danger",
    };
}
