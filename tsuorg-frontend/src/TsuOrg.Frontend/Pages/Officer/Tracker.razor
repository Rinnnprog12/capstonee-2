@page "/officer/tracker"
@layout PortalLayout
@attribute [Authorize(Roles = "OrgOfficer,Adviser,Dean,SouStaff,SystemAdmin")]
@inject NavigationManager Nav
@inject AuthSession Session
@inject ApiClient Api

<PageTitle>Document Tracker</PageTitle>

<div class="page-head">
    <a class="back-btn" href="@BackHref">← Back</a>
    <h1>Document Tracker</h1>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="form-error" role="alert">@_error</p>
}

<div class="tabs">
    @foreach (var tab in Tabs)
    {
        var count = TabCount(tab.Api);
        <button type="button"
                class="tab @(_tab == tab.Api ? "active" : null)"
                @onclick="() => SwitchTabAsync(tab.Api)">
            @tab.Label (@count)
        </button>
    }
    <label class="tracker-sort spacer">
        <select class="select" value="@_sort" @onchange="OnSortChanged">
            <option value="newest">Sort: newest</option>
            <option value="oldest">Sort: oldest</option>
        </select>
    </label>
</div>

@if (_loading)
{
    <p class="hint">Loading documents…</p>
}
else if (_items.Count == 0)
{
    <section class="panel">
        <p class="empty-state">
            @if (IsReviewer)
            {
                <text>No documents from your assigned organizations in this stage yet.</text>
            }
            else
            {
                <text>No documents in this view yet.</text>
            }
        </p>
    </section>
}
else
{
    <div class="recent-list" role="list">
        @foreach (var doc in SortedItems)
        {
            <button type="button"
                    class="list-row list-row-btn"
                    role="listitem"
                    @onclick="() => Open(doc)">
                <div class="doc-ico @IconTone(doc.OverallStatus)">📄</div>
                <div>
                    <div class="title">@doc.Title</div>
                    <div class="meta">
                        @doc.DocumentNumber · @doc.OrganizationName · @doc.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy")
                    </div>
                </div>
                <div class="right">
                    <StatusBadge Status="@BadgeStatus(doc.OverallStatus)" />
                    @if (doc.Score is int s)
                    {
                        <span class="score compliance-score @ScoreTone(s)">
                            <strong>@s%</strong><br />
                            <small>compliance</small>
                        </span>
                    }
                </div>
            </button>
        }
    </div>
}

@code {
    /// <summary>Figure 17 pipeline tabs (Adviser/Dean). Officers also get Returned.</summary>
    private static readonly (string Api, string Label)[] PipelineTabs =
    [
        ("All", "All"),
        ("Submitted", "Submitted"),
        ("AiValidated", "AI validated"),
        ("AdviserReview", "Adviser review"),
        ("DeanReview", "Dean review"),
        ("Approved", "Approved"),
    ];

    private static readonly (string Api, string Label)[] OfficerExtraTab =
    [
        ("Returned", "Returned"),
    ];

    private string _tab = "All";
    private string _sort = "newest";
    private bool _loading = true;
    private string? _error;
    private List<TrackerDocumentCardDto> _items = [];
    private Dictionary<string, int> _tabCounts = new(StringComparer.OrdinalIgnoreCase);

    private bool IsReviewer => Session.Role is "Adviser" or "Dean";

    private IEnumerable<(string Api, string Label)> Tabs =>
        IsReviewer || Session.Role is "SouStaff" or "SystemAdmin"
            ? PipelineTabs
            : PipelineTabs.Concat(OfficerExtraTab);

    private string BackHref => Session.Role is "Adviser" or "Dean" ? "/review"
        : Session.Role is "SouStaff" or "SystemAdmin" ? "/sou"
        : "/officer";

    private IEnumerable<TrackerDocumentCardDto> SortedItems => _sort == "oldest"
        ? _items.OrderBy(d => d.CreatedAt)
        : _items.OrderByDescending(d => d.CreatedAt);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SwitchTabAsync(string tab)
    {
        if (_tab == tab && !_loading) return;
        _tab = tab;
        await LoadAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "newest";
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetTrackerAsync(_tab);
            _items = result.Items.ToList();
            _tabCounts = result.TabCounts.ToDictionary(t => t.Tab, t => t.Count, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private int TabCount(string tab) =>
        _tabCounts.TryGetValue(tab, out var n) ? n : 0;

    /// <summary>
    /// Figure 17/18: always open tracing detail (live timeline + audit from DB).
    /// Review actions stay on the detail CTA / Review Queue.
    /// </summary>
    private void Open(TrackerDocumentCardDto doc) =>
        Nav.NavigateTo($"/officer/tracker/{doc.Id}");

    private static string BadgeStatus(string overall) => overall switch
    {
        "Returned for revision" => "Returned for revision",
        "Flagged — needs revision" => "Flagged",
        "AI validating" => "submitted",
        "SOU review" => "Under review",
        _ => overall,
    };

    private static string ScoreTone(int pct) => pct switch
    {
        >= 80 => "ok",
        >= 60 => "warn",
        _ => "danger",
    };

    private static string IconTone(string overall) => overall switch
    {
        "Returned for revision" or "Flagged — needs revision" or "Rejected" => "danger",
        "Dean review" => "warn",
        "Adviser review" or "AI validating" or "Submitted" => "info",
        "Approved" or "Archived" or "SOU review" => "",
        _ => "",
    };
}
