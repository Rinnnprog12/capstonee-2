@page "/officer"
@layout PortalLayout
@inject DemoSession Session

<PageTitle>Officer Dashboard</PageTitle>

<div class="welcome">
    <h2>Hello, @Session.FullName!</h2>
    <p>Welcome to TSU-ORGDOCX. Submit, track, and manage your organization's documents in real-time.</p>
</div>

<section class="grid-4" aria-label="Document lifecycle overview">
    <div class="stat-card">
        <div class="stat-icon">★</div>
        <div><div class="value">4</div><div class="label">Total Submitted</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">📁</div>
        <div><div class="value">2</div><div class="label">Under Review</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">✓</div>
        <div><div class="value">1</div><div class="label">Approved</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon">↩</div>
        <div><div class="value">1</div><div class="label">Returned</div></div>
    </div>
</section>

<section class="grid-3" aria-label="Analytics">
    <div class="panel metric-big">
        <div class="label">Outstanding Docs</div>
        <div class="value">2</div>
    </div>
    <div class="panel metric-big">
        <div class="label">Compliance Rate</div>
        <div class="value">87%</div>
    </div>
    <div class="panel metric-big">
        <div class="label">Items Flagged</div>
        <div class="value">1</div>
    </div>
</section>

<section class="panel">
    <div class="panel-title">
        <h3>Recent Submissions</h3>
        <a class="btn btn-outline-teal btn-sm" href="officer/submit">+ New Submission</a>
    </div>

    <div class="list-row">
        <div class="doc-ico warn">📄</div>
        <div>
            <div class="title">Activity Proposal – SocNight Rehearsal</div>
            <div class="meta">DOC-2026-0041 · Apr 10, 2026</div>
        </div>
        <div class="right"><StatusBadge Status="Under review" /></div>
    </div>
    <div class="list-row">
        <div class="doc-ico">📄</div>
        <div>
            <div class="title">Accomplishment Report – February</div>
            <div class="meta">DOC-2026-0038 · Mar 28, 2026</div>
        </div>
        <div class="right"><StatusBadge Status="Approved" /></div>
    </div>
    <div class="list-row">
        <div class="doc-ico danger">📄</div>
        <div>
            <div class="title">Accomplishment Report – March</div>
            <div class="meta">DOC-2026-0040 · Apr 02, 2026</div>
        </div>
        <div class="right"><StatusBadge Status="returned" /></div>
    </div>
    <div class="list-row">
        <div class="doc-ico info">📄</div>
        <div>
            <div class="title">Application Form – New Member Reg.</div>
            <div class="meta">DOC-2026-0035 · Mar 15, 2026</div>
        </div>
        <div class="right"><StatusBadge Status="Submitted" /></div>
    </div>
</section>
