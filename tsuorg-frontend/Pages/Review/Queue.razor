@page "/review/queue"
@layout PortalLayout

<PageTitle>Review Queue</PageTitle>

<div class="page-head">
    <a class="back-btn" href="review">← Back</a>
    <h1>Review Queue</h1>
</div>

<section class="panel">
    <div class="list-row">
        <div class="doc-ico warn">📄</div>
        <div>
            <div class="title">Activity Proposal – SocNight Rehearsal</div>
            <div class="meta">DOC-2026-0041 · Artist Circle · Score 87%</div>
        </div>
        <div class="right">
            <button type="button" class="btn btn-primary btn-sm">Approve</button>
            <button type="button" class="btn btn-ghost btn-sm">Return</button>
            <button type="button" class="btn btn-ghost btn-sm" style="border-color:var(--danger);color:var(--danger);">Reject</button>
        </div>
    </div>
    <div class="list-row">
        <div class="doc-ico purple">📄</div>
        <div>
            <div class="title">Accomplishment Report – March</div>
            <div class="meta">DOC-2026-0042 · Artist Circle · Score 92%</div>
        </div>
        <div class="right">
            <button type="button" class="btn btn-primary btn-sm">Approve</button>
            <button type="button" class="btn btn-ghost btn-sm">Return</button>
        </div>
    </div>
    <div class="list-row">
        <div class="doc-ico info">📄</div>
        <div>
            <div class="title">Activity Proposal – Campus Clean Drive</div>
            <div class="meta">DOC-2026-0040 · CSC · Score 95%</div>
        </div>
        <div class="right">
            <button type="button" class="btn btn-primary btn-sm">Approve</button>
            <button type="button" class="btn btn-ghost btn-sm">Return</button>
        </div>
    </div>
</section>
