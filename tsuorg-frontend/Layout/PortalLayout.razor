@inherits LayoutComponentBase
@inject DemoSession Session
@inject NavigationManager Nav
@implements IDisposable

<div class="portal">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <img class="brand-logo" src="images/tsu-logo.png" alt="Tarlac State University" />
            <strong>Tarlac State University</strong>
        </div>

        <div class="user-block">
            <div class="avatar" aria-hidden="true">@Session.Initials</div>
            <div>
                <div class="name">@Session.FullName</div>
                <div class="meta">@Session.Subtitle</div>
                @if (IsReviewer)
                {
                    <span class="role-pill">@Session.Role</span>
                }
            </div>
        </div>

        <nav class="nav-list" aria-label="Primary">
            @foreach (var item in NavItems)
            {
                <NavLink class="nav-item" href="@item.Href" Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @((MarkupString)item.Icon)
                    <span>@item.Label</span>
                </NavLink>
            }
        </nav>

        <button type="button" class="nav-signout" @onclick="SignOut">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <path d="M16 17l5-5-5-5"/>
                <path d="M21 12H9"/>
            </svg>
            Sign out
        </button>
    </aside>

    <div class="portal-main">
        <header class="topbar">
            <button type="button" class="icon-btn" title="Language" aria-label="Language">文</button>
            <button type="button" class="icon-btn" title="Account" aria-label="Account">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/></svg>
            </button>
            <span class="portal-label">@Session.PortalLabel</span>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsReviewer => Session.Role is "Adviser" or "Dean" or "SouStaff";

    private IEnumerable<NavDef> NavItems => Session.Role switch
    {
        "Adviser" or "Dean" => new NavDef[]
        {
            new("/review", "Home", IconHome, true),
            new("/review/queue", "Review Queue", IconQueue),
            new("/officer/tracker", "Document Tracker", IconTrack),
            new("/review/history", "Review History", IconHistory),
            new("/review/audit", "Audit Log", IconAudit),
        },
        "SouStaff" => new NavDef[]
        {
            new("/sou", "Home", IconHome, true),
            new("/review/queue", "Review Queue", IconQueue),
            new("/officer/tracker", "Document Tracker", IconTrack),
            new("/officer/documents", "Repository", IconFolder),
        },
        _ => new NavDef[]
        {
            new("/officer", "Home", IconHome, true),
            new("/officer/submit", "New Submission", IconPlus),
            new("/officer/tracker", "Document Tracker", IconTrack),
            new("/officer/documents", "Org Documents", IconFolder),
        }
    };

    private void SignOut()
    {
        Session.SignOut();
        Nav.NavigateTo("/login");
    }

    protected override void OnInitialized() => Session.Changed += StateHasChanged;
    public void Dispose() => Session.Changed -= StateHasChanged;

    private sealed record NavDef(string Href, string Label, string Icon, bool Exact = false);

    private const string IconHome = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z"/></svg>""";
    private const string IconPlus = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>""";
    private const string IconTrack = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/><circle cx="16.5" cy="16.5" r="3.5"/><path d="m18.5 18.5 1.5 1.5"/></svg>""";
    private const string IconFolder = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>""";
    private const string IconQueue = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>""";
    private const string IconHistory = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5M12 7v5l3 2"/></svg>""";
    private const string IconAudit = """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16M6 20V10l6-6 6 6v10M9 20v-6h6v6"/></svg>""";
}
